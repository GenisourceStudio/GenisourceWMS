# Copy to .env and change every value marked "change-me".
# These defaults match compose.yaml so `docker compose up` works out of the box
# for local evaluation; never use them on a reachable host.

# Port exposed by the web container. 8100 keeps clear of GenisourceMES (8080).
WEB_PORT=8100

# PostgreSQL.
DB_NAME=genisource_wms
DB_USER=wms
DB_PASSWORD=change-me-db-password

# Initial administrator. Created on first startup by AdminBootstrap.
WMS_ADMIN_USERNAME=admin
WMS_ADMIN_PASSWORD=change-me-admin-password

# HMAC key for JWT signing. At least 32 bytes; rotating it signs out every session.
WMS_JWT_SECRET=change-me-jwt-secret-at-least-32-bytes-long

# Mirrors for image builds: central | aliyun, and the npm registry.
MAVEN_MIRROR=central
NPM_REGISTRY=https://registry.npmjs.org
